# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Supabase SECRET (service role) key - SERVER ONLY, never prefix it with NEXT_PUBLIC_.
# Used only for first-time account setup (verification codes + creating the account).
# Project Settings > API Keys > "Secret keys" (sb_secret_...) or the legacy "service_role" key.
SUPABASE_SECRET_KEY=

# Resend (https://resend.com) - sends the 6-digit verification codes.
# API key: Resend dashboard > API Keys > Create API key (permission: Sending access).
RESEND_API_KEY=
# Sender on a domain you verified in Resend (Resend dashboard > Domains), e.g.
# EMAIL_FROM="UA Scholar <noreply@your-verified-domain.com>"
EMAIL_FROM=

# Postgres connection used ONLY by the Prisma CLI for migrations (never by the app).
# Supabase Dashboard > Connect > "Session pooler" (port 5432). Do not use port 6543.
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:5432/postgres

# Public URL of this app (used for email confirmation links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AES secret used by app/_lib/aes-encryption.js (any random string, at least 32 characters).
# The student key and the admin key are both derived from it.
# NEVER commit it, and back it up: if it is lost or changed, encrypted data cannot be recovered.
AES_SECRET_KEY=
